# Copy this file to .env and fill it in. Never commit .env.

# --- Database ---
# Local (docker compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/filinglens
# Neon (hosted), looks like:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- SEC requires a name and email to download filings ---
SEC_IDENTITY="Your Name your.email@example.com"

# --- LLM: ollama (local) | anthropic | openai (also Groq, OpenRouter) | mock ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# For the hosted demo on Render, use one of these instead of Ollama:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# LLM_PROVIDER=openai
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant

# --- Search models (defaults are fine) ---
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Pipeline switches (all on by default) ---
USE_BM25=true
USE_RERANK=true
USE_AGENT=true
USE_VERIFY=true
